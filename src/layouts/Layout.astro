---
// COMMON DHAANCHA — har page isko use karta hai.
import '../styles/global.css';
import Header from '../components/Header.astro';
import { ClientRouter } from 'astro:transitions';

const {
  title = 'Kanishk Verma — 3D video, illustration and comics with generative AI',
  description =
    'Portfolio of Kanishk Verma: 3D science explainer videos, textbook illustration and comics, made with generative AI and finished to broadcast and print quality.',
  image = '/video/gangajal.webp',
} = Astro.props;
const ogImage = new URL(image, 'https://kannisshk.pages.dev').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#17183a" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2317183a'/%3E%3Ctext x='16' y='22.5' font-family='Arial' font-weight='700' font-size='17' text-anchor='middle' fill='%23ffc531'%3EKV%3C/text%3E%3C/svg%3E"
    />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <slot />

    <footer class="site-foot">
      <div class="wrap foot-in">
        <span>Kanishk Verma, Delhi NCR</span>
        <span class="foot-links">
          <a href="mailto:kanishkverma688@gmail.com">kanishkverma688@gmail.com</a>
          <a href="https://www.instagram.com/unseen.3d/" target="_blank" rel="noopener">Instagram</a>
          <a href="https://github.com/Kanishk688" target="_blank" rel="noopener">GitHub</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-foot {
    margin-top: 6rem;
    background: var(--night);
    color: var(--night-dim);
    font-size: 0.95rem;
  }
  .foot-in {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 2.25rem;
  }
  .foot-links { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .foot-links a { color: var(--night-ink); }
  .foot-links a:hover { color: var(--sun); }
</style>
