---
// COMMON DHAANCHA — har page isko use karega.
import '../styles/global.css';
import Header from '../components/Header.astro';
import { ClientRouter } from 'astro:transitions';

const {
  title = 'Kanishk Verma — Generative Media Engineer',
  description =
    'Generative media engineer. I build the pipelines that turn a manuscript into print-ready artwork at book scale — style locked, every reject archived, cost measured per delivered asset.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />

    <!-- favicon: CMYK registration dots, kyunki kaam print ka hai -->
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23e8e9ec'/%3E%3Ccircle cx='9' cy='9' r='6' fill='%230090cf'/%3E%3Ccircle cx='23' cy='9' r='6' fill='%23d1006b'/%3E%3Ccircle cx='9' cy='23' r='6' fill='%23f2c200'/%3E%3Ccircle cx='23' cy='23' r='6' fill='%23141417'/%3E%3C/svg%3E"
    />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <slot />

    <footer class="wrap" style="padding-block: 3.5rem 4rem; border-top: 1px solid var(--rule); margin-top: 5rem;">
      <div style="display:flex; flex-wrap:wrap; gap:1.5rem; justify-content:space-between; align-items:baseline;">
        <span class="label">Kanishk Kumar Verma — Delhi NCR</span>
        <a class="label label-mag" href="mailto:kanishkverma688@gmail.com">kanishkverma688@gmail.com</a>
      </div>
    </footer>

    <!-- SCROLL REVEAL: jaise hi koi .reveal element screen me aata hai, use dikhao. -->
    <script>
      function setupReveal() {
        const els = document.querySelectorAll('.reveal:not(.in)');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', setupReveal);
    </script>
  </body>
</html>
