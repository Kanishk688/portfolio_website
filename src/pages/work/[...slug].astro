---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const items = project.data.gallery.map((g) =>
  typeof g === 'string' ? { src: g, chapter: undefined, caption: undefined } : g
);

// chapter ke hisaab se group karo, order wahi rakho jaise likha hai.
const groups: { chapter: string; images: typeof items }[] = [];
for (const it of items) {
  const key = it.chapter ?? '';
  let g = groups.find((x) => x.chapter === key);
  if (!g) { g = { chapter: key, images: [] }; groups.push(g); }
  g.images.push(it);
}

let idx = 0;

// ---- KAB BANA ----
// Saal akela kaafi nahi; us waqt tooling kahan thi ye bhi spec ka hissa hai.
const made = project.data.date;
const madeOn = made.toLocaleString('en-GB', { month: 'long', year: 'numeric' });
const madeYear = made.getFullYear();
---

<Layout title={`${project.data.title} — Kanishk Verma`} description={project.data.summary}>
  <main class="wrap" style="padding-block: 2.5rem 2rem;">
    <a class="label" href="/work/" style="color: var(--ink-2);">← Index</a>

    <!-- ---------------- HEAD ---------------- -->
    <header style="margin-top:2rem; padding-bottom:2rem; border-bottom:1px solid var(--ink);">
      <p class="reveal label label-mag">
        {madeYear}{project.data.company ? ` · ${project.data.company}` : ''}
      </p>
      <h1 class="reveal d1 display" style="font-size: clamp(2.4rem, 5.5vw, 4rem); margin-top:0.8rem;">
        {project.data.title}
      </h1>
      <p class="reveal d2 lede" style="margin-top:1.2rem;">{project.data.summary}</p>
    </header>

    <!-- ---------------- SPEC ---------------- -->
    <div class="spec-grid" style="margin-top:2.5rem;">
      <div class="reveal">
        <p class="label">Built with the tools of {madeYear}</p>
        {project.data.eraNote && (
          <p style="margin-top:0.9rem; color: var(--ink-2); max-width: 58ch;">{project.data.eraNote}</p>
        )}
        {project.data.externalUrl && (
          <a class="btn btn-ghost" href={project.data.externalUrl} target="_blank" rel="noopener" style="margin-top:1.4rem;">
            {project.data.externalLabel ?? 'View the full work'} ↗
          </a>
        )}
      </div>

      <table class="reveal d1 spec">
        <tbody>
          <tr><td>Produced</td><td>{madeOn}</td></tr>
          {project.data.company && <tr><td>Client</td><td>{project.data.company}</td></tr>}
          {project.data.role && <tr><td>Role</td><td>{project.data.role}</td></tr>}
          {project.data.tools.length > 0 && (
            <tr><td>Tools</td><td>{project.data.tools.join(', ')}</td></tr>
          )}
          <tr><td>Plates</td><td>{items.length}</td></tr>
        </tbody>
      </table>
    </div>

    <!-- ---------------- BODY ---------------- -->
    <div class="reveal case-body" style="margin-top:3.5rem;">
      <Content />
    </div>

    <!-- ---------------- PLATES ---------------- -->
    {groups.map((group) => (
      <section style="margin-top:4rem;">
        {group.chapter && (
          <div class="reveal" style="display:flex; align-items:baseline; justify-content:space-between; gap:1rem; padding-bottom:0.75rem; margin-bottom:1.5rem; border-bottom:1px solid var(--ink);">
            <h2 class="display" style="font-size:1.4rem; line-height:1.1;">{group.chapter}</h2>
            <span class="label mono">{group.images.length} pl.</span>
          </div>
        )}
        <div class="plate-grid">
          {group.images.map((img) => (
            <figure class="reveal plate" style="margin:0;">
              <img
                src={img.src}
                alt={img.caption ?? project.data.title}
                data-idx={idx++}
                data-caption={img.caption ?? ''}
                class="lightbox-img"
                loading="lazy"
              />
              {img.caption && <figcaption>{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    ))}
  </main>

  <!-- ===== LIGHTBOX ===== -->
  <div id="lightbox" style="position:fixed; inset:0; z-index:100; display:none; align-items:center; justify-content:center; background:rgba(20,20,23,.94); backdrop-filter:blur(2px); user-select:none;">
    <button id="lb-close" aria-label="Close" class="label" style="position:absolute; top:1rem; right:1.25rem; color:#e8e9ec; background:none; border:0; font-size:1.5rem; cursor:pointer;">×</button>
    <button id="lb-prev" aria-label="Previous" class="label" style="position:absolute; left:1rem; top:50%; transform:translateY(-50%); color:#e8e9ec; background:none; border:1px solid #55585f; width:2.75rem; height:2.75rem; cursor:pointer;">‹</button>
    <figure style="max-height:92vh; max-width:92vw; display:flex; flex-direction:column; align-items:center; gap:0.9rem; margin:0;">
      <img id="lb-img" src="" alt="" style="max-height:82vh; max-width:92vw; object-fit:contain; background:#fff;" />
      <figcaption style="text-align:center; color:#c5c8ce; font-size:0.9rem; max-width:60ch; padding-inline:1rem;">
        <span id="lb-cap"></span>
        <span id="lb-count" class="label" style="display:block; margin-top:0.4rem;"></span>
      </figcaption>
    </figure>
    <button id="lb-next" aria-label="Next" class="label" style="position:absolute; right:1rem; top:50%; transform:translateY(-50%); color:#e8e9ec; background:none; border:1px solid #55585f; width:2.75rem; height:2.75rem; cursor:pointer;">›</button>
  </div>

  <script>
    function setupLightbox() {
      const box = document.getElementById('lightbox');
      const img = document.getElementById('lb-img') as HTMLImageElement | null;
      const cap = document.getElementById('lb-cap');
      const count = document.getElementById('lb-count');
      if (!box || !img || !cap || !count) return;

      const els = Array.from(document.querySelectorAll<HTMLImageElement>('.lightbox-img'));
      const list = els.map((el) => ({ src: el.src, caption: el.dataset.caption || '' }));
      let cur = 0;

      function show(i: number) {
        cur = (i + list.length) % list.length;
        img!.src = list[cur].src;
        cap!.textContent = list[cur].caption;
        count!.textContent = `${cur + 1} / ${list.length}`;
      }
      function open(i: number) {
        show(i);
        box!.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
      function close() {
        box!.style.display = 'none';
        document.body.style.overflow = '';
      }

      els.forEach((el, i) => el.addEventListener('click', () => open(i)));
      document.getElementById('lb-close')?.addEventListener('click', close);
      document.getElementById('lb-prev')?.addEventListener('click', (e) => { e.stopPropagation(); show(cur - 1); });
      document.getElementById('lb-next')?.addEventListener('click', (e) => { e.stopPropagation(); show(cur + 1); });
      box.addEventListener('click', (e) => { if (e.target === box) close(); });

      document.addEventListener('keydown', (e) => {
        if (box.style.display !== 'flex') return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') show(cur - 1);
        else if (e.key === 'ArrowRight') show(cur + 1);
      });

      let sx = 0;
      box.addEventListener('touchstart', (e) => { sx = e.changedTouches[0].clientX; }, { passive: true });
      box.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - sx;
        if (Math.abs(dx) > 45) show(cur + (dx < 0 ? 1 : -1));
      }, { passive: true });
    }
    document.addEventListener('astro:page-load', setupLightbox);
  </script>
</Layout>

<style>
  .spec-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  /* CSS columns = masonry. Plates ki height alag-alag hoti hai (portrait
     comic page, landscape diagram), grid me us se badi khaali jagah bachti. */
  .plate-grid { columns: 3 17rem; column-gap: 1.25rem; }
  .plate-grid > * { break-inside: avoid; margin-bottom: 1.25rem; }
  @media (max-width: 900px) {
    .spec-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
