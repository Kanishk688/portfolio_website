---
// 404 — iske bina Cloudflare Pages har anjaan URL pe home page 200 ke saath
// serve kar deta tha.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Kanishk Verma" description="That page does not exist.">
  <main class="night nf">
    <div class="wrap">
      <h1 class="h-hero">This page doesn’t exist.</h1>
      <p class="lede" style="margin-top:1.25rem;">The link may be old or mistyped. All the work is on the home page.</p>
      <div style="display:flex; flex-wrap:wrap; gap:0.75rem; margin-top:2rem;">
        <a class="btn" href="/">Go to the home page</a>
        <a class="btn btn-line" href="/#videos">Watch the videos</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .nf { padding-block: 6rem 7rem; }
</style>
