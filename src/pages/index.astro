---
// HOME — recruiter ka pura raasta ek page pe:
//   hero (kaun hoon + 3 chalti videos) → videos → kitaabein → comics → about.
// Har hissa header ke link se seedha khulta hai.
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { videos } from '../data/videos';

const all = await getCollection('projects');
const newest = (a: any, b: any) => b.data.date.getTime() - a.data.date.getTime();
const books = all.filter((p) => p.data.medium === 'illustration').sort(newest);
const comics = all.filter((p) => p.data.medium === 'comics').sort(newest);

const explainers = videos.filter((v) => v.group === 'explainer');
const otherMotion = videos.filter((v) => v.group !== 'explainer');

const hero = ['ev', 'gangajal', 'agni5'].map((id) => videos.find((v) => v.id === id)!);

const illoCount = books.reduce(
  (n, p) => n + p.data.gallery.filter((g) => typeof g === 'string' || !g.chapter?.startsWith('Rejected attempts')).length,
  0,
);
---

<Layout>
  <!-- ====================== HERO ====================== -->
  <section class="night hero">
    <div class="wrap hero-in">
      <div class="hero-text">
        <p class="hello">Hi, I’m Kanishk Verma, a generative media designer.</p>
        <h1 class="h-hero">I make 3D explainer videos, illustrated textbooks and comics with AI.</h1>
        <p class="lede">
          Everything here was made for a real audience: {explainers.length} science reels for
          Instagram, {books.length} school textbooks headed for print, and {comics.length} children’s comics.
          I build the pipeline and I own how the final piece looks.
        </p>
        <div class="hero-cta">
          <a class="btn" href="#videos">Watch the videos</a>
          <a class="btn btn-line" href="#illustration">See the books</a>
        </div>
      </div>

      <div class="hero-reels" aria-label="Three of the videos, playing without sound">
        {hero.map((v, i) => (
          <button type="button" class={`hero-reel r${i}`} data-vid={v.id} aria-label={`Play: ${v.title}`}>
            <video muted loop playsinline preload="none" poster={`/video/${v.id}.webp`} data-loop={`/video/${v.id}-loop.mp4`}></video>
            <span class="hero-reel-cap">{v.title}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ====================== VIDEOS ====================== -->
  <section id="videos" class="night sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 class="h-section">3D explainer videos</h2>
          <p class="muted">
            Science and defence stories in Hinglish, made October–November 2026 for my Instagram
            channel <a class="inline-link" href="https://www.instagram.com/unseen.3d/" target="_blank" rel="noopener">@unseen.3d</a>.
            Every shot is a real 3D scene built in Blender or three.js rather than a generated clip,
            so the science stays correct from one shot to the next. Click any video to watch it with sound.
          </p>
        </div>
      </div>
      <div class="vgrid">
        {explainers.map((v) => <VideoCard v={v} />)}
      </div>

      <h3 class="sub-head">Textbook chapter video</h3>
      <div class="vgrid vgrid-mixed">
        {otherMotion.map((v) => <VideoCard v={v} />)}
      </div>
    </div>
  </section>

  <!-- ====================== BOOKS ====================== -->
  <section id="illustration" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 class="h-section">Textbook illustration</h2>
          <p class="muted">
            {books.length} school books, {illoCount}+ illustrations shown here, made June–November 2026 for
            Possibility Edutech (Jaipuria Group). Each book keeps its characters and style locked from the
            first page to the last, every diagram is checked for correct science, and the files are delivered
            at 300 DPI for print.
          </p>
        </div>
      </div>
      <div class="proj-grid">
        {books.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>

  <!-- ====================== COMICS ====================== -->
  <section id="comics" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 class="h-section">Comics</h2>
          <p class="muted">
            {comics.length} illustrated children’s comics made at Wippi in 2025. Image models then could not
            keep a character the same from one page to the next, so consistency came from reference sheets,
            many rejected attempts and careful hand-picking. Every speech bubble was typeset by hand.
          </p>
        </div>
      </div>
      <div class="proj-grid">
        {comics.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>

  <!-- ====================== ABOUT ====================== -->
  <section id="about" class="sec">
    <div class="wrap about">
      <div>
        <h2 class="h-section">About me</h2>
        <div class="about-text">
          <p>
            I take a brief, whether it’s a textbook chapter or a science question, and turn it into
            finished images and video using AI models, 3D tools and code.
          </p>
          <p>
            The models are good at making something that looks right. My job is to make sure it is right:
            the skull in a science diagram has eye sockets, the same child looks like herself on page 40, and
            the file is good enough to print or broadcast.
          </p>
        </div>
        <div class="hero-cta">
          <a class="btn" href="mailto:kanishkverma688@gmail.com">Email me</a>
          <a class="btn btn-line" href="https://github.com/Kanishk688/genai-illustration-pipeline" target="_blank" rel="noopener">My pipeline on GitHub</a>
        </div>
      </div>

      <div>
        <h3 class="col-head">Experience</h3>
        <ol class="jobs">
          <li>
            <span class="when">Feb 2026 – now</span>
            <strong>Assistant Manager, AI Initiatives</strong>
            <span class="muted">Possibility Edutech (Jaipuria Group), Delhi NCR. Textbook illustration and chapter videos.</span>
          </li>
          <li>
            <span class="when">Oct 2026 – now</span>
            <strong>Creator, @unseen.3d</strong>
            <span class="muted">My own Instagram channel of 3D science explainers.</span>
          </li>
          <li>
            <span class="when">Nov 2024 – Dec 2025</span>
            <strong>AI &amp; IoT Generalist</strong>
            <span class="muted">Wippi (Gen Alpha Kids First Media Tech), Bangalore. Comics and ElevenLabs voiceovers.</span>
          </li>
        </ol>

        <h3 class="col-head">Tools I use</h3>
        <dl class="tools">
          <div><dt>Images</dt><dd>GPT Image, Gemini (Nano Banana), Magnific, Photoshop</dd></div>
          <div><dt>3D and video</dt><dd>Blender, three.js, HyperFrames, Remotion</dd></div>
          <div><dt>Voice and sound</dt><dd>ElevenLabs, AI music</dd></div>
          <div><dt>Automation</dt><dd>Python, Claude Code with MCP agents</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <VideoPlayer />

  <script>
    // Hero ki 3 videos: sirf tab chalein jab user ne "reduce motion" na lagaya ho.
    function setupHero() {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLButtonElement>('.hero-reel').forEach((b) => {
        const v = b.querySelector('video')!;
        if (!reduce) { v.src = v.dataset.loop!; v.play().catch(() => {}); }
        b.addEventListener('click', () => {
          (document.querySelector(`.vcard[data-vid="${b.dataset.vid}"]`) as HTMLElement | null)?.click();
        });
      });
    }
    document.addEventListener('astro:page-load', setupHero);
  </script>
</Layout>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem); overflow: hidden; }
  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }
  .hello { color: var(--sun); font-weight: 600; margin: 0 0 1rem; font-size: 1.1rem; }
  .hero .lede { margin-top: 1.5rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .hero-reels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    align-items: center;
  }
  .hero-reel {
    position: relative;
    padding: 0;
    border: 0;
    background: var(--night-2);
    border-radius: var(--r-lg);
    overflow: hidden;
    aspect-ratio: 9 / 16;
    cursor: pointer;
    box-shadow: 0 20px 50px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.08);
  }
  .hero-reel.r1 { transform: translateY(-1.5rem); }
  .hero-reel video { width: 100%; height: 100%; object-fit: cover; }
  .hero-reel-cap {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 2.5rem 0.75rem 0.75rem;
    background: linear-gradient(transparent, rgba(0,0,0,.78));
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: left;
  }

  /* ---------- sections ---------- */
  .sec { padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  #videos { padding-top: 1.5rem; }
  #comics { padding-top: 0; }
  .inline-link { color: var(--sun); text-decoration: underline; text-underline-offset: 3px; }

  .vgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 11rem), 1fr));
    gap: 2rem 1.1rem;
  }
  .vgrid-mixed { grid-template-columns: minmax(0, 40rem); }
  .sub-head { font-weight: 680; font-size: 1.35rem; letter-spacing: -0.015em; margin: 3.5rem 0 1.25rem; }

  /* ---------- about ---------- */
  #about { border-top: 1px solid var(--line); }
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
  .about-text { max-width: 52ch; margin-top: 1.25rem; color: var(--ink-2); font-size: 1.1rem; }
  .about-text p + p { margin-top: 1rem; }
  .col-head { font-weight: 680; font-size: 1.15rem; margin: 0 0 1rem; }
  .col-head + * { margin-bottom: 2.5rem; }
  .jobs { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .jobs li { display: grid; gap: 0.15rem; padding-left: 1rem; border-left: 3px solid var(--sun); }
  .when { font-size: 0.9rem; color: var(--ink-3); }
  .tools { display: grid; gap: 0.6rem; margin: 0; }
  .tools div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; }
  .tools dt { color: var(--ink-3); }
  .tools dd { margin: 0; }

  @media (max-width: 900px) {
    .hero-in { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero-reels { max-width: 34rem; }
    .about { grid-template-columns: 1fr; gap: 3rem; }
    .vgrid-mixed { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .hero-reel-cap { display: none; }
    .tools div { grid-template-columns: 1fr; gap: 0; }
  }
</style>
