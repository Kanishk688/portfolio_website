---
// HOME = press docket. Hero me ek asli specimen (reject bनाम printed),
// phir numbers, phir kaam.
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('projects');
const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// ---- GINTI (gallery se, haath se nahi) ----
const isComic = (p: (typeof all)[number]) =>
  p.data.tags.some((t) => /comic/i.test(t));

let imgCount = 0;
const chapterSet = new Set<string>();
const comicTitles = new Set<string>();
const marqueeAll: string[] = [];
for (const p of all) {
  for (const it of p.data.gallery) {
    imgCount++;
    const src = typeof it === 'string' ? it : it.src;
    marqueeAll.push(src);
    if (typeof it !== 'string' && it.chapter) {
      if (isComic(p)) comicTitles.add(it.chapter);
      else chapterSet.add(p.id + '::' + it.chapter);
    }
  }
}
const bookCount = all.filter((p) => !isComic(p)).length;

// marquee ke liye ~40 ka spread
const step = Math.max(1, Math.floor(marqueeAll.length / 40));
const strip = marqueeAll.filter((_, i) => i % step === 0).slice(0, 40);

// ---- DOCKET ----
// Grade-5 wahi ek book hai jisne rejects archive kiye, isliye numbers
// sirf usi ke honestly claim kiye ja sakte hain.
const docket = [
  { k: 'Textbooks illustrated', v: String(bookCount) },
  { k: 'Comic titles / volumes', v: `${comicTitles.size} / 10` },
  { k: 'Chapters & units', v: String(chapterSet.size) },
  { k: 'Pages published here', v: `${Math.floor(imgCount / 10) * 10}+` },
  { k: 'Measured run — delivered', v: '58', hi: true },
  { k: 'Measured run — generations', v: '165', hi: true },
  { k: 'Measured run — discarded', v: '107', hi: true },
];
---

<Layout title="Kanishk Verma — Generative Media Engineer">
  <!-- ========================= HERO ========================= -->
  <section class="wrap" style="padding-block: 4rem 3rem;">
    <div class="hero-grid">
      <!-- pitch -->
      <div>
        <p class="reveal label label-mag">Generative Media Engineer</p>

        <h1 class="reveal d1 display" style="font-size: clamp(2.9rem, 7vw, 5.4rem); margin-top: 1.1rem;">
          I build the<br />pipeline, and<br />the archive that<br />proves its cost.
        </h1>

        <p class="reveal d2 lede" style="margin-top: 1.6rem;">
          Manuscript in, 300&nbsp;DPI print files out. Style locked across
          hundreds of assets, every rejected attempt kept and named with the
          reason it failed — so the run can report what it actually cost
          instead of only what shipped.
        </p>

        <div class="reveal d3" style="display:flex; flex-wrap:wrap; gap:0.75rem; margin-top:2rem;">
          <a class="btn" href="/work/">See the work</a>
          <a class="btn btn-ghost" href="/work/jaipuria-science-grade5/">Read the measured run</a>
        </div>
      </div>

      <!-- specimen: site ka signature -->
      <figure class="reveal d2 specimen" style="margin:0;">
        <div class="specimen-grid">
          <div class="specimen-cell">
            <div class="specimen-head">
              <span class="stamp stamp-rej">Rejected</span>
              <span class="label">Att. 1</span>
            </div>
            <img src="/work/rej-skull-noeyes.webp" alt="A rejected attempt: the skull has no eye sockets." loading="eager" />
          </div>
          <div class="specimen-cell">
            <div class="specimen-head">
              <span class="stamp stamp-ok">Printed</span>
              <span class="label">Att. 9</span>
            </div>
            <img src="/work/fin-skull.webp" alt="The delivered illustration: the skull has correct eye sockets and teeth." loading="eager" />
          </div>
        </div>
        <figcaption class="specimen-foot">
          <span>c1_04_v1_no_eyesockets_WRONG.png</span>
          <span>8 attempts archived · Grade-5 Science</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- artwork band -->
  <div class="marquee" style="border-block: 1px solid var(--ink); padding-block: 0.75rem; background: var(--paper-hi);">
    <div class="marquee-track marquee-l">
      {[...strip, ...strip].map((src) => (
        <img src={src} alt="" loading="lazy" style="height:5.5rem; width:auto; display:block;" />
      ))}
    </div>
  </div>

  <!-- ========================= DOCKET ========================= -->
  <section class="wrap" style="padding-block: 4.5rem;">
    <div class="docket-grid">
      <div>
        <p class="reveal label">Job docket</p>
        <h2 class="reveal d1 display" style="font-size: clamp(1.9rem, 3.4vw, 2.8rem); margin-top: 0.8rem;">
          Counted from<br />the files on disk.
        </h2>
        <p class="reveal d2" style="color: var(--ink-2); margin-top: 1.1rem; max-width: 34ch;">
          One book kept every reject instead of overwriting it. That book is the
          only one here whose cost is a measurement rather than a memory — and
          the earlier ones are left without numbers rather than given
          flattering ones.
        </p>
      </div>

      <table class="reveal d1 spec">
        <tbody>
          {docket.map((row) => (
            <tr>
              <td>{row.k}</td>
              <td>{row.hi ? <strong>{row.v}</strong> : row.v}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ========================= WORK ========================= -->
  <section class="wrap" style="padding-block: 1rem 4rem;">
    <div style="display:flex; align-items:baseline; justify-content:space-between; gap:1rem; padding-bottom:0.9rem; border-bottom:1px solid var(--ink);">
      <h2 class="reveal label" style="color: var(--ink);">Selected work</h2>
      <a class="reveal label label-mag" href="/work/">All projects →</a>
    </div>

    <div class="work-grid" style="margin-top:2rem;">
      {featured.map((p) => (
        <a class="reveal card" href={`/work/${p.id}/`}>
          <img src={p.data.cover} alt={p.data.title} loading="lazy" style="aspect-ratio: 16/10; object-fit: cover;" />
          <div class="card-body">
            <p class="label mono">{p.data.date.getFullYear()}{p.data.company ? ` · ${p.data.company}` : ''}</p>
            <h3 class="display" style="font-size:1.35rem; margin-top:0.5rem; line-height:1.1;">{p.data.title}</h3>
            <p style="color: var(--ink-2); font-size:0.95rem; margin-top:0.6rem;">{p.data.summary.slice(0, 128)}…</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ========================= ABOUT ========================= -->
  <section class="wrap" style="padding-block: 3rem 4rem; border-top: 1px solid var(--rule);">
    <div class="docket-grid">
      <div>
        <p class="reveal label">Colophon</p>
        <h2 class="reveal d1 display" style="font-size: clamp(1.9rem, 3.4vw, 2.8rem); margin-top:0.8rem;">
          How the work<br />gets made.
        </h2>
      </div>

      <div class="reveal d1" style="max-width: var(--measure);">
        <p>
          I’m Kanishk. I build generative image pipelines and own what comes out
          of them — the prompts, the agent loops, the review gates and the
          visual quality of the final asset.
        </p>
        <p style="margin-top:1.05rem;">
          A chapter is read into a shot list, every illustration is generated
          against a locked style bible and a fixed palette, rejects go to an
          archive named with the reason they failed, and an automated QA script
          checks resolution, alpha, print density and edge halos before
          anything is delivered.
        </p>
        <p style="margin-top:1.05rem;">
          That last part is the difference. A pipeline that deletes its failures
          can only ever report good news.
        </p>

        <table class="spec" style="margin-top:2rem;">
          <tbody>
            <tr><td>Build with</td><td>Claude Code + MCP, agent loops, Python, n8n</td></tr>
            <tr><td>Generate with</td><td>Gemini, GPT Image, Magnific, Veo, ElevenLabs</td></tr>
            <tr><td>Ship as</td><td>300 DPI print files, QA-gated</td></tr>
            <tr><td>Open source</td><td><a href="https://github.com/Kanishk688/genai-illustration-pipeline" style="color:var(--magenta); text-decoration:underline; text-underline-offset:3px;">genai-illustration-pipeline</a></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ========================= CONTACT ========================= -->
  <section class="wrap" style="padding-block: 3rem 1rem;">
    <p class="reveal label">Contact</p>
    <h2 class="reveal d1 display" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin-top:0.8rem; max-width:18ch;">
      Need a pipeline built, or one that stopped behaving?
    </h2>
    <a class="reveal d2 btn" style="margin-top:1.8rem;" href="mailto:kanishkverma688@gmail.com">
      kanishkverma688@gmail.com
    </a>
  </section>
</Layout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3.5rem;
    align-items: start;
  }
  .docket-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 900px) {
    .hero-grid, .docket-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
