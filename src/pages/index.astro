---
// HOME — recruiter ka pura raasta ek page pe:
//   hero (kaun hoon + 3 chalti videos) → videos → kitaabein → comics → about.
// Har hissa header ke link se seedha khulta hai.
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { videos } from '../data/videos';
import { jobs, projects } from '../data/experience';
import JobBlock from '../components/JobBlock.astro';

const all = await getCollection('projects');
const newest = (a: any, b: any) => b.data.date.getTime() - a.data.date.getTime();
const books = all.filter((p) => p.data.medium === 'illustration').sort(newest);
const comics = all.filter((p) => p.data.medium === 'comics').sort(newest);

const explainers = videos.filter((v) => v.group === 'explainer');
const otherMotion = videos.filter((v) => v.group !== 'explainer');

const hero = ['ev', 'gangajal', 'agni5'].map((id) => videos.find((v) => v.id === id)!);

const illoCount = books.reduce(
  (n, p) => n + p.data.gallery.filter((g) => typeof g === 'string' || !g.chapter?.startsWith('Rejected attempts')).length,
  0,
);
---

<Layout>
  <!-- ====================== HERO ====================== -->
  <section class="night hero">
    <div class="wrap hero-in">
      <div class="hero-text">
        <p class="hello">Kanishk Kumar Verma, creative technologist</p>
        <h1 class="h-hero hero-h1">I build the systems behind generative media, not one&#8209;off outputs.</h1>
        <p class="lede">
          An agent pipeline that turns textbook manuscripts into print-ready art, and 3D video
          rendered entirely in code with Three.js, Blender and HyperFrames.
        </p>
        <div class="hero-cta">
          <a class="btn" href="#videos">Watch the videos</a>
          <a class="btn btn-line" href="#illustration">See the books</a>
        </div>
      </div>

      <div class="hero-reels" aria-label="Three of the videos, playing without sound">
        {hero.map((v, i) => (
          <button type="button" class={`hero-reel r${i}`} data-vid={v.id} aria-label={`Play: ${v.title}`}>
            <video muted loop playsinline preload="none" poster={`/video/${v.id}.webp`} data-loop={`/video/${v.id}-loop.mp4`}></video>
            <span class="hero-reel-cap">{v.title}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="wrap">
      <dl class="stats">
        <div><dt>print-ready illustrations</dt><dd>1,500+</dd></div>
        <div><dt>textbooks</dt><dd>10+</dd></div>
        <div><dt>illustrated comics</dt><dd>25+</dd></div>
        <div><dt>hours of voiced stories</dt><dd>30+</dd></div>
        <div><dt>views on best reel</dt><dd>1.5M+</dd></div>
      </dl>
    </div>
  </section>

  <!-- ====================== VIDEOS ====================== -->
  <section id="videos" class="night sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 class="h-section">3D explainer videos</h2>
          <p class="muted">
            Science and defence stories in Hinglish for my Instagram channel
            <a class="inline-link" href="https://www.instagram.com/unseen.3d/" target="_blank" rel="noopener">@unseen.3d</a>,
            where the best reel has passed 1.5M organic views. Each reel is built entirely in code instead of
            paying per clip for a video model: Three.js and shaders for scenes and lighting, Blender for models,
            HyperFrames and Remotion for frame-accurate rendering, ElevenLabs for narration. Because every reel is
            code, it can be re-rendered and edited parameter by parameter. Click any video to watch it with sound.
          </p>
        </div>
      </div>
      <div class="vgrid">
        {explainers.map((v) => <VideoCard v={v} />)}
      </div>

      <h3 class="sub-head">Textbook chapter video</h3>
      <div class="vgrid vgrid-mixed">
        {otherMotion.map((v) => <VideoCard v={v} />)}
      </div>
    </div>
  </section>

  <!-- ====================== BOOKS ====================== -->
  <section id="illustration" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 class="h-section">Textbook illustration</h2>
          <p class="muted">
            Made at Possibility Edutech (Jaipuria Group) for a network of 60+ schools. My agent pipeline
            (Claude Code + MCP) takes a .docx manuscript to 300 DPI print-ready artwork, and has shipped
            1,500+ illustrations across 10+ textbooks with locked style, consistent characters and an
            automated print-QA gate. {books.length} of those books are shown here, {illoCount}+ illustrations in all.
          </p>
        </div>
      </div>
      <div class="proj-grid">
        {books.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>

  <!-- ====================== COMICS ====================== -->
  <section id="comics" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 class="h-section">Comics</h2>
          <p class="muted">
            25+ illustrated comics made at Wippi in 2024–25, {comics.length} of them shown here. This was before
            image models had character-reference features, so characters stayed on-model through reference
            sheets and careful selection, and all dialogue was typeset in InDesign. Every comic was also voiced
            with my multi-character ElevenLabs engine, about an hour of audio per title.
          </p>
        </div>
      </div>
      <div class="proj-grid">
        {comics.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>

  <!-- ====================== EXPERIENCE (resume se) ====================== -->
  <section id="experience" class="sec">
    <div class="wrap">
      <h2 class="h-section">Experience</h2>
      <div class="jobs-list">
        {jobs.map((j) => <JobBlock job={j} />)}
      </div>

      <h2 class="h-section" style="margin-top:3.5rem;">Projects</h2>
      <div class="jobs-list">
        {projects.map((j) => <JobBlock job={j} />)}
      </div>
    </div>
  </section>

  <!-- ====================== ABOUT ====================== -->
  <section id="about" class="sec about-sec">
    <div class="wrap about">
      <div>
        <h2 class="h-section">About me</h2>
        <div class="about-text">
          <p>
            Creative technologist who builds the <strong>production systems behind generative media</strong>,
            not one-off outputs. I designed an <strong>agent-orchestrated pipeline (Claude Code + MCP)</strong> that
            has shipped <strong>1,500+ print-ready illustrations</strong> across <strong>10+ textbooks</strong> for a
            60+ school network, with routed image models, locked style and character consistency, and automated
            print QA.
          </p>
          <p>
            I make <strong>code-rendered 3D video</strong> with Three.js, shaders, Blender, Remotion and HyperFrames;
            my best reel reached <strong>1.5M+ views</strong>. I treat models as instruments: evaluated, routed by
            task and measured by cost per delivered asset.
          </p>
        </div>
        <div class="hero-cta">
          <a class="btn" href="mailto:kanishkverma688@gmail.com">Email me</a>
          <a class="btn btn-line" href="https://www.linkedin.com/in/kanishk-verma" target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn btn-line" href="https://github.com/Kanishk688" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>

      <div>
        <h3 class="col-head">Skills</h3>
        <dl class="tools">
          <div><dt>Generative media</dt><dd>GPT Image, Nano Banana Pro (Gemini), Seedream, Magnific, Veo, ElevenLabs. Evaluated: Midjourney, Flux, SDXL/ComfyUI, Imagen, Runway, Kling</dd></div>
          <div><dt>Real-time 3D and motion</dt><dd>Three.js, WebGL, shaders, Blender, Remotion, HyperFrames, FFmpeg</dd></div>
          <div><dt>Agentic systems</dt><dd>Claude Code, MCP servers, skills/CLAUDE.md, n8n, model routing, compiled prompt templates</dd></div>
          <div><dt>Engineering</dt><dd>Python (Pillow, NumPy, SciPy), pytest, GitHub Actions, HTML/CSS/JS, Astro, Cloudflare Pages, Vercel, AWS S3/IAM</dd></div>
          <div><dt>Art direction and print</dt><dd>Style bibles, character consistency, Photoshop, InDesign hand-off, 300 DPI / alpha / colour QA</dd></div>
        </dl>

        <h3 class="col-head">Education</h3>
        <dl class="tools">
          <div><dt>2025</dt><dd>B.Tech, Computer Science Engineering, Chandigarh University</dd></div>
          <div><dt>2021</dt><dd>Senior Secondary (12th, PCM), CBSE</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <VideoPlayer />

  <script>
    // Hero ki 3 videos: sirf tab chalein jab user ne "reduce motion" na lagaya ho.
    function setupHero() {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLButtonElement>('.hero-reel').forEach((b) => {
        const v = b.querySelector('video')!;
        if (!reduce) { v.src = v.dataset.loop!; v.play().catch(() => {}); }
        b.addEventListener('click', () => {
          (document.querySelector(`.vcard[data-vid="${b.dataset.vid}"]`) as HTMLElement | null)?.click();
        });
      });
    }
    document.addEventListener('astro:page-load', setupHero);
  </script>
</Layout>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem); overflow: hidden; }
  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }
  .hero-h1 { font-size: clamp(2.3rem, 4.4vw, 3.9rem); hyphens: manual; }
  .hello { color: var(--sun); font-weight: 600; margin: 0 0 1rem; font-size: 1.1rem; }
  .hero .lede { margin-top: 1.5rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .hero-reels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    align-items: center;
  }
  .hero-reel {
    position: relative;
    padding: 0;
    border: 0;
    background: var(--night-2);
    border-radius: var(--r-lg);
    overflow: hidden;
    aspect-ratio: 9 / 16;
    cursor: pointer;
    box-shadow: 0 20px 50px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.08);
  }
  .hero-reel.r1 { transform: translateY(-1.5rem); }
  .hero-reel video { width: 100%; height: 100%; object-fit: cover; }
  .hero-reel-cap {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 2.5rem 0.75rem 0.75rem;
    background: linear-gradient(transparent, rgba(0,0,0,.78));
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: left;
  }

  /* ---------- sections ---------- */
  .sec { padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  #videos { padding-top: 1.5rem; }
  #comics { padding-top: 0; }
  .inline-link { color: var(--sun); text-decoration: underline; text-underline-offset: 3px; }

  .vgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 11rem), 1fr));
    gap: 2rem 1.1rem;
  }
  .vgrid-mixed { grid-template-columns: minmax(0, 40rem); }
  .sub-head { font-weight: 680; font-size: 1.35rem; letter-spacing: -0.015em; margin: 3.5rem 0 1.25rem; }

  /* ---------- about ---------- */
  #experience { background: var(--raised); border-top: 1px solid var(--line); }
  .jobs-list { margin-top: 1.25rem; }
  .about-text strong { color: var(--ink); font-weight: 650; }
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
  .about-text { max-width: 52ch; margin-top: 1.25rem; color: var(--ink-2); font-size: 1.1rem; }
  .about-text p + p { margin-top: 1rem; }
  .col-head { font-weight: 680; font-size: 1.15rem; margin: 0 0 1rem; }
  .col-head + * { margin-bottom: 2.5rem; }

  /* resume ke numbers — hero ke neeche */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    justify-content: space-between;
    margin: 3rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255,255,255,.12);
  }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dd { margin: 0; font-weight: 750; font-size: 1.6rem; letter-spacing: -0.02em; color: var(--night-ink); line-height: 1.1; }
  .stats dt { font-size: 0.85rem; color: var(--night-dim); }
  .tools { display: grid; gap: 0.6rem; margin: 0; }
  .tools div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; }
  .tools dt { color: var(--ink-3); }
  .tools dd { margin: 0; }

  @media (max-width: 900px) {
    .hero-in { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero-reels { max-width: 34rem; }
    .about { grid-template-columns: 1fr; gap: 3rem; }
    .vgrid-mixed { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .hero-reel-cap { display: none; }
    .tools div { grid-template-columns: 1fr; gap: 0; }
  }
</style>
