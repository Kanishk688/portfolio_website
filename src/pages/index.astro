---
// HOME — pehle kaam dikhta hai, phir batata hai ki kaise bana.
// (Pehle yahan reject-vs-printed specimen sabse upar tha. Concept accha tha
//  par portfolio ka pehla kaam hai "ye banda accha banata hai" dikhana, aur
//  do skeleton diagram us kaam ke liye galat pehli image thi. Specimen ab
//  neeche docket ke saath hai, jahan woh numbers ko sahi thehraata hai.)
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('projects');
const byId = (id: string) => all.find((p) => p.id === id)!;

const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

// ---- HERO SHOWCASE: teen sabse achhi images, teen alag mood ----
const showcase = [
  { src: '/work/g5-c6-pond-story-scene.webp', p: byId('jaipuria-science-grade5') },
  { src: '/work/comic-mermaid-v1-p01.webp',   p: byId('comic-mermaid') },
  { src: '/work/g4-c9-opening.webp',          p: byId('jaipuria-science-textbook') },
];

// ---- GINTI (gallery se, haath se nahi) ----
let imgCount = 0;
const chapterSet = new Set<string>();
const volumeSet = new Set<string>();
const marqueeAll: string[] = [];
for (const p of all) {
  for (const it of p.data.gallery) {
    imgCount++;
    const src = typeof it === 'string' ? it : it.src;
    marqueeAll.push(src);
    if (typeof it !== 'string' && it.chapter) {
      if (p.data.medium === 'comics') volumeSet.add(p.id + '::' + it.chapter);
      else chapterSet.add(p.id + '::' + it.chapter);
    }
  }
}
const bookCount = all.filter((p) => p.data.medium === 'illustration').length;
const comicCount = all.filter((p) => p.data.medium === 'comics').length;

// har medium kitna hai — range ek nazar me
const media = [...new Set(all.map((p) => p.data.medium))].map((m) => ({
  label: m.charAt(0).toUpperCase() + m.slice(1),
  n: all.filter((p) => p.data.medium === m).length,
}));

const step = Math.max(1, Math.floor(marqueeAll.length / 40));
const strip = marqueeAll.filter((_, i) => i % step === 0).slice(0, 40);

const docket = [
  { k: 'Textbooks illustrated', v: String(bookCount) },
  { k: 'Comic titles', v: `${comicCount} across ${volumeSet.size} volumes` },
  { k: 'Chapters & units', v: String(chapterSet.size) },
  { k: 'Pages published here', v: `${Math.floor(imgCount / 10) * 10}+` },
  { k: 'Measured run — delivered', v: '58', hi: true },
  { k: 'Measured run — generations', v: '165', hi: true },
  { k: 'Measured run — discarded', v: '107', hi: true },
];

const mediumLabel = (m: string) => m.charAt(0).toUpperCase() + m.slice(1);
---

<Layout title="Kanishk Verma — Generative Media Engineer">
  <!-- ========================= HERO ========================= -->
  <section class="wrap" style="padding-block: 4rem 2.5rem;">
    <p class="reveal label label-mag">Generative Media Engineer · Delhi NCR</p>

    <h1 class="reveal d1 display" style="font-size: clamp(2.8rem, 6.4vw, 5.2rem); margin-top: 1.1rem; max-width: 20ch;">
      Illustration and comics, built by pipeline and finished for print.
    </h1>

    <div class="hero-foot">
      <p class="reveal d2 lede" style="margin:0;">
        Five textbooks and five comic titles — 480 pages delivered at
        300&nbsp;DPI. I build the generation pipeline, the review gates and the
        print QA, and I own how the final artwork looks.
      </p>
      <div class="reveal d3" style="display:flex; flex-wrap:wrap; gap:0.75rem;">
        <a class="btn" href="/work/">See the work</a>
        <a class="btn btn-ghost" href="/work/jaipuria-science-grade5/">How it’s made</a>
      </div>
    </div>
  </section>

  <!-- ===================== SHOWCASE ===================== -->
  <section class="wrap" style="padding-bottom: 3rem;">
    <div class="showcase">
      {showcase.map(({ src, p }, i) => (
        <a class={`reveal ${i ? 'd' + i : ''} showcase-item`} href={`/work/${p.id}/`}>
          <img src={src} alt={p.data.title} loading={i === 0 ? 'eager' : 'lazy'} />
          <span class="showcase-cap">
            <span class="label label-mag">{mediumLabel(p.data.medium)}</span>
            <span class="showcase-title">{p.data.title}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ===================== PRACTICE =====================
       Kaunse medium me kaam hai, ek nazar me. Ye list schema se aati hai —
       jis din video ya animation ka pehla project add hoga, woh yahan khud
       aa jayega, koi edit nahi karna padega. -->
  <section class="wrap" style="padding-bottom: 2.5rem;">
    <div class="practice">
      <span class="label" style="align-self:center;">Practice</span>
      {media.map((m) => (
        <a class="practice-item" href="/work/">
          <span class="practice-label">{m.label}</span>
          <span class="label mono">{m.n}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- artwork band -->
  <div class="marquee" style="border-block: 1px solid var(--ink); padding-block: 0.75rem; background: var(--paper-hi);">
    <div class="marquee-track marquee-l">
      {[...strip, ...strip].map((src) => (
        <img src={src} alt="" loading="lazy" style="height:5.5rem; width:auto; display:block;" />
      ))}
    </div>
  </div>

  <!-- ========================= WORK ========================= -->
  <section class="wrap" style="padding-block: 4rem;">
    <div style="display:flex; align-items:baseline; justify-content:space-between; gap:1rem; padding-bottom:0.9rem; border-bottom:1px solid var(--ink);">
      <h2 class="reveal label" style="color: var(--ink);">Selected work</h2>
      <a class="reveal label label-mag" href="/work/">All projects →</a>
    </div>

    <div class="work-grid" style="margin-top:2rem;">
      {featured.map((p) => (
        <a class="reveal card" href={`/work/${p.id}/`}>
          <img src={p.data.cover} alt={p.data.title} loading="lazy" style="aspect-ratio: 16/10; object-fit: cover;" />
          <div class="card-body">
            <p class="label" style="display:flex; justify-content:space-between; gap:0.75rem;">
              <span class="label-mag">{mediumLabel(p.data.medium)}</span>
              <span class="mono">{p.data.date.getFullYear()}</span>
            </p>
            <h3 class="display" style="font-size:1.35rem; margin-top:0.5rem; line-height:1.1;">{p.data.title}</h3>
            <p style="color: var(--ink-2); font-size:0.95rem; margin-top:0.6rem;">{p.data.summary.slice(0, 128)}…</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ================= DOCKET + SPECIMEN =================
       Numbers, aur unke saath woh ek image jo unko sach saabit karti hai. -->
  <section class="wrap" style="padding-block: 3rem 4.5rem; border-top: 1px solid var(--rule);">
    <p class="reveal label">Job docket</p>
    <h2 class="reveal d1 display" style="font-size: clamp(1.9rem, 3.4vw, 2.8rem); margin-top: 0.8rem; max-width: 22ch;">
      Counted from the files on disk.
    </h2>

    <div class="docket-grid" style="margin-top:2.5rem;">
      <table class="reveal spec">
        <tbody>
          {docket.map((row) => (
            <tr>
              <td>{row.k}</td>
              <td>{row.hi ? <strong>{row.v}</strong> : row.v}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="reveal d1">
        <p style="color: var(--ink-2); margin:0 0 1.4rem; max-width: 46ch;">
          One book kept every rejected attempt instead of overwriting it, which
          is why it is the only one here whose cost is a measurement rather
          than a memory. This is what one of those rejects looks like — the
          skull has no eye sockets.
        </p>

        <figure class="specimen" style="margin:0;">
          <div class="specimen-grid">
            <div class="specimen-cell">
              <div class="specimen-head">
                <span class="stamp stamp-rej">Rejected</span>
                <span class="label">Att. 1</span>
              </div>
              <img src="/work/rej-skull-noeyes.webp" alt="A rejected attempt: the skull has no eye sockets." loading="lazy" />
            </div>
            <div class="specimen-cell">
              <div class="specimen-head">
                <span class="stamp stamp-ok">Printed</span>
                <span class="label">Att. 9</span>
              </div>
              <img src="/work/fin-skull.webp" alt="The delivered illustration: the skull has correct eye sockets and teeth." loading="lazy" />
            </div>
          </div>
          <figcaption class="specimen-foot">
            <span>c1_04_v1_no_eyesockets_WRONG.png</span>
            <span>8 attempts archived</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ========================= ABOUT ========================= -->
  <section class="wrap" style="padding-block: 3rem 4rem; border-top: 1px solid var(--rule);">
    <div class="docket-grid">
      <div>
        <p class="reveal label">Colophon</p>
        <h2 class="reveal d1 display" style="font-size: clamp(1.9rem, 3.4vw, 2.8rem); margin-top:0.8rem;">
          How the work<br />gets made.
        </h2>
      </div>

      <div class="reveal d1" style="max-width: var(--measure);">
        <p>
          I’m Kanishk. I build generative image pipelines and own what comes out
          of them — the prompts, the agent loops, the review gates and the
          visual quality of the final asset.
        </p>
        <p style="margin-top:1.05rem;">
          A chapter is read into a shot list, every illustration is generated
          against a locked style bible and a fixed palette, rejects go to an
          archive named with the reason they failed, and an automated QA script
          checks resolution, alpha, print density and edge halos before
          anything is delivered.
        </p>

        <table class="spec" style="margin-top:2rem;">
          <tbody>
            <tr><td>Build with</td><td>Claude Code + MCP, agent loops, Python, n8n</td></tr>
            <tr><td>Generate with</td><td>Gemini, GPT Image, Magnific, Veo, ElevenLabs</td></tr>
            <tr><td>Ship as</td><td>300 DPI print files, QA-gated</td></tr>
            <tr><td>Open source</td><td><a href="https://github.com/Kanishk688/genai-illustration-pipeline" style="color:var(--magenta); text-decoration:underline; text-underline-offset:3px;">genai-illustration-pipeline</a></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ========================= CONTACT ========================= -->
  <section class="wrap" style="padding-block: 3rem 1rem;">
    <p class="reveal label">Contact</p>
    <h2 class="reveal d1 display" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin-top:0.8rem; max-width:18ch;">
      Need a pipeline built, or one that stopped behaving?
    </h2>
    <a class="reveal d2 btn" style="margin-top:1.8rem;" href="mailto:kanishkverma688@gmail.com">
      kanishkverma688@gmail.com
    </a>
  </section>
</Layout>

<style>
  .hero-foot {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: end;
    margin-top: 2rem;
  }

  /* SHOWCASE — pehla impression. Teen bade plates, alag mood. */
  .showcase {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .showcase-item {
    display: block;
    border: 1px solid var(--rule);
    background: var(--paper-hi);
    transition: border-color .18s ease, transform .18s ease;
  }
  .showcase-item:hover { border-color: var(--ink); transform: translateY(-3px); }
  .showcase-item img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .showcase-cap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1rem 1rem;
    border-top: 1px solid var(--rule);
  }
  .showcase-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .docket-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1.5rem;
  }
  .practice {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-left: 1rem;
    gap: 0;
  }
  .practice > .label { padding-right: 1.5rem; }
  .practice-item {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.85rem 1.25rem;
    border-left: 1px solid var(--rule);
    color: var(--ink);
    transition: background .15s ease;
  }
  .practice-item:hover { background: var(--paper-hi); }
  .practice-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  @media (max-width: 900px) {
    .hero-foot { grid-template-columns: 1fr; gap: 1.5rem; align-items: start; }
    .showcase { grid-template-columns: 1fr; }
    .docket-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
