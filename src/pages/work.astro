---
// /work/ — saara kaam ek jagah, bina kisi lambi baat ke.
// (Home page pe bhi yahi sab hai; ye page purane links ke liye zinda hai.)
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { videos } from '../data/videos';

const all = await getCollection('projects');
const newest = (a: any, b: any) => b.data.date.getTime() - a.data.date.getTime();
const books = all.filter((p) => p.data.medium === 'illustration').sort(newest);
const comics = all.filter((p) => p.data.medium === 'comics').sort(newest);
---

<Layout title="All work — Kanishk Verma">
  <section class="night sec-w">
    <div class="wrap">
      <h1 class="h-hero">All work</h1>
      <p class="lede" style="margin-top:1rem;">
        {videos.length} videos, {books.length} textbooks and {comics.length} comics. Click a video to watch it,
        or a book to see every illustration in it.
      </p>
      <h2 class="h-section" style="margin-top:3rem;">Videos</h2>
      <div class="vgrid">
        {videos.map((v) => <VideoCard v={v} />)}
      </div>
    </div>
  </section>

  <section class="sec-w">
    <div class="wrap">
      <h2 class="h-section">Textbook illustration</h2>
      <div class="proj-grid" style="margin-top:1.5rem;">
        {books.map((p) => <ProjectCard p={p} />)}
      </div>
      <h2 class="h-section" style="margin-top:4rem;">Comics</h2>
      <div class="proj-grid" style="margin-top:1.5rem;">
        {comics.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>

  <VideoPlayer />
</Layout>

<style>
  .sec-w { padding-block: 3.5rem; }
  .vgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 11rem), 1fr));
    gap: 2rem 1.1rem;
    margin-top: 1.5rem;
    align-items: start;
  }
  .vgrid :global(.vcard-wide) { grid-column: span 2; }
</style>
