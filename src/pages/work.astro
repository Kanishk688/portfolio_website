---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// har project ke tags se filter-categories nikaalo (slugs).
function catsFor(tags: string[]): string[] {
  const cats: string[] = [];
  if (tags.some((t) => /science/i.test(t))) cats.push('science');
  if (tags.some((t) => /english/i.test(t))) cats.push('english');
  if (tags.some((t) => /comic/i.test(t))) cats.push('comics');
  for (const t of tags) {
    const m = t.match(/grade\s*(\d+)/i);
    if (m) cats.push('grade-' + m[1]);
  }
  return cats;
}

const withCats = projects.map((p) => ({ p, cats: catsFor(p.data.tags) }));
const has = (c: string) => withCats.some((x) => x.cats.includes(c));
const chips = [
  { slug: 'all', label: 'All' },
  { slug: 'science', label: 'Science' },
  { slug: 'english', label: 'English' },
  { slug: 'comics', label: 'Comics' },
  { slug: 'grade-1', label: 'Gr 1' },
  { slug: 'grade-2', label: 'Gr 2' },
  { slug: 'grade-3', label: 'Gr 3' },
  { slug: 'grade-4', label: 'Gr 4' },
  { slug: 'grade-5', label: 'Gr 5' },
].filter((c) => c.slug === 'all' || has(c.slug));

// ---- SAAL KE HISAAB SE ----
// AI tooling har saal alag hoti hai. Bina saal ke, purana kaam aaj ke
// standard se tola jaata hai aur galat nateeja nikalta hai.
const ERAS: Record<number, string> = {
  2026:
    'Character and style consistency had largely become something the tools handled. ' +
    'The difficulty moved to correctness, print QA, and knowing what each delivered asset cost.',
  2025:
    'No character reference, no style lock, no printable generated text. Keeping a cast ' +
    'recognisable across a whole book was manual work, and every speech bubble was typeset over the art.',
};

const years = [...new Set(withCats.map((x) => x.p.data.date.getFullYear()))].sort((a, b) => b - a);
const byYear = years.map((year) => ({
  year,
  era: ERAS[year],
  items: withCats.filter((x) => x.p.data.date.getFullYear() === year),
}));
---

<Layout title="Work — Kanishk Verma">
  <main class="wrap" style="padding-block: 3.5rem 2rem;">
    <p class="reveal label label-mag">Index of work</p>
    <h1 class="reveal d1 display" style="font-size: clamp(2.6rem, 6vw, 4.4rem); margin-top:0.9rem;">
      Sorted by what<br />the tools could do.
    </h1>
    <p class="reveal d2 lede" style="margin-top:1.4rem;">
      Grouped by the year each project was made, because in generative work the
      year is part of the spec — what took a week in 2025 can take an afternoon
      now, and the same will be said of 2026.
    </p>

    <!-- FILTERS -->
    <div id="filters" class="reveal d2" style="display:flex; flex-wrap:wrap; gap:1.25rem; margin-top:2.5rem; padding-bottom:0.5rem; border-bottom:1px solid var(--ink);">
      {chips.map((c, i) => (
        <button type="button" data-filter={c.slug} class:list={['filter', i === 0 && 'is-active']}>
          {c.label}
        </button>
      ))}
    </div>

    <!-- HAR SAAL KA BLOCK -->
    {byYear.map(({ year, era, items }) => (
      <section class="year-block" data-year={year} style="margin-top:3.5rem;">
        <div class="year-head reveal">
          <span class="display mono" style="font-size:2.6rem; line-height:1;">{year}</span>
          {era && <p style="color: var(--ink-2); font-size:0.95rem; max-width:56ch; margin:0;">{era}</p>}
        </div>

        <div class="work-grid">
          {items.map(({ p, cats }) => (
            <div class="project-card reveal" data-cats={cats.join(' ')}>
              <a class="card" href={`/work/${p.id}/`}>
                <img src={p.data.cover} alt={p.data.title} loading="lazy" style="aspect-ratio: 4/3; object-fit: cover;" />
                <div class="card-body">
                  {p.data.company && <p class="label mono">{p.data.company}</p>}
                  <h2 class="display" style="font-size:1.3rem; margin-top:0.5rem; line-height:1.1;">{p.data.title}</h2>
                  <p style="color: var(--ink-2); font-size:0.92rem; margin-top:0.55rem;">{p.data.summary.slice(0, 110)}…</p>
                  <p style="margin-top:0.9rem;">
                    {p.data.tags.map((t) => <span class="tag">{t}</span>)}
                  </p>
                </div>
              </a>
            </div>
          ))}
        </div>
      </section>
    ))}

    <p id="empty" class="label" style="display:none; text-align:center; padding-block:4rem;">
      Nothing in this filter yet.
    </p>
  </main>

  <script>
    function setupFilters() {
      const chips = document.querySelectorAll<HTMLButtonElement>('.filter');
      const cards = document.querySelectorAll<HTMLElement>('.project-card');
      const blocks = document.querySelectorAll<HTMLElement>('.year-block');
      const empty = document.getElementById('empty');
      if (!chips.length) return;

      function apply(slug: string) {
        let shown = 0;
        cards.forEach((card) => {
          const cats = (card.dataset.cats || '').split(' ');
          const show = slug === 'all' || cats.includes(slug);
          card.style.display = show ? '' : 'none';
          if (show) shown++;
        });
        // khaali saal ka heading bhi hata do
        blocks.forEach((b) => {
          const alive = [...b.querySelectorAll<HTMLElement>('.project-card')]
            .some((c) => c.style.display !== 'none');
          b.style.display = alive ? '' : 'none';
        });
        if (empty) empty.style.display = shown ? 'none' : 'block';
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.remove('is-active'));
          chip.classList.add('is-active');
          apply(chip.dataset.filter || 'all');
        });
      });
    }
    document.addEventListener('astro:page-load', setupFilters);
  </script>
</Layout>

<style>
  .year-head {
    display: flex;
    align-items: baseline;
    gap: 2rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--ink);
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 640px) {
    .year-head { flex-direction: column; gap: 0.6rem; }
  }
</style>
