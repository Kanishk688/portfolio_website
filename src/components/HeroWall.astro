---
// HERO REELS — beech me Agni-5 aur BrahMos (sabse badi), dono taraf
// baaki reels thodi chhoti hoti hui. Saari reels poori dikhti hain
// (na crop, na dhundhle kinaare) aur bina awaaz chalti rehti hain.
// Desktop: 6 reels. Tablet: 4. Phone: sirf beech ki 2.
// Click = video player (awaaz ke saath).
// Video: public/video/<id>-hero.mp4 (480px, 6 sec). Poster: public/wall/<id>.webp
import { videos } from '../data/videos';

// level 0 = beech (sabse badi), 1 = uske bagal, 2 = sabse bahar
const row: { id: string; level: number }[] = [
  { id: 's400', level: 2 },
  { id: 'ev', level: 1 },
  { id: 'agni5', level: 0 },
  { id: 'brahmos', level: 0 },
  { id: 'laser', level: 1 },
  { id: 'helmet', level: 2 },
];
const reels = row.map((r) => ({ ...r, v: videos.find((v) => v.id === r.id)! }));
---

<div class="stage" aria-label="Six of the reels, playing without sound. Tap one to watch it with sound.">
  {reels.map(({ v, level }) => (
    <button type="button" class={`reel lv${level}`} data-vid={v.id} aria-label={`Play: ${v.title}`}>
      <span class="reel-frame">
        <video muted loop playsinline preload="none" poster={`/wall/${v.id}.webp`} data-loop={`/video/${v.id}-hero.mp4`} width="480" height="854"></video>
        <span class="reel-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
        </span>
      </span>
      <span class="reel-title">{v.title}</span>
    </button>
  ))}
</div>

<script>
  function setupStage() {
    const stage = document.querySelector<HTMLElement>('.stage');
    if (!stage || stage.dataset.ready) return;
    stage.dataset.ready = '1';

    stage.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-vid]');
      if (!b) return;
      (document.querySelector(`.vcard[data-vid="${b.dataset.vid}"]`) as HTMLElement | null)?.click();
    });

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // Jo reel screen pe ho wo chale; scroll karke neeche chale jao to ruk jaaye.
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        const v = en.target as HTMLVideoElement;
        if (en.isIntersecting) {
          if (!v.src) v.src = v.dataset.loop!;
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      }
    });
    stage.querySelectorAll('video').forEach((v) => {
      if (v.offsetParent) io.observe(v); // chhupi reel (phone pe) load hi mat karo
    });
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  document.addEventListener('astro:page-load', setupStage);
</script>

<style>
  .stage {
    --w: min(13.5rem, 16vw);   /* beech wali reel ki chaudai */
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
    padding: 1.5rem clamp(1rem, 3vw, 2.5rem) 0.5rem;
  }
  .reel {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .lv0 { width: var(--w); }
  .lv1 { width: calc(var(--w) * 0.84); }
  .lv2 { width: calc(var(--w) * 0.7); }
  /* neeche wala title bhi upar-neeche barabar rahe, isliye title ki jagah fix */
  .reel-title { min-height: 2.5em; }

  .reel-frame {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    border-radius: 16px;
    overflow: hidden;
    background: var(--raised);
    box-shadow: 0 0 0 1px rgba(255,255,255,.1), 0 22px 48px rgba(0,0,0,.5);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s ease;
  }
  .lv0 .reel-frame { box-shadow: 0 0 0 1px rgba(255,197,49,.35), 0 26px 60px rgba(0,0,0,.55), 0 0 80px rgba(255,197,49,.10); }
  .reel-frame video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .reel:hover .reel-frame,
  .reel:focus-visible .reel-frame {
    transform: translateY(-8px);
    box-shadow: 0 0 0 3px var(--sun), 0 30px 60px rgba(0,0,0,.55);
  }
  .reel-play {
    position: absolute;
    left: 0.7rem; bottom: 0.7rem;
    display: grid; place-items: center;
    width: 2.5rem; height: 2.5rem;
    border-radius: 50%;
    background: var(--sun);
    color: var(--sun-ink);
    box-shadow: 0 6px 16px rgba(0,0,0,.35);
  }
  .reel-title {
    font-weight: 620;
    font-size: 0.95rem;
    line-height: 1.25;
    color: var(--night-ink);
  }
  .lv0 .reel-title { font-size: 1.02rem; }
  .lv2 .reel-title { font-size: 0.85rem; color: var(--night-dim); }

  /* tablet: 4 reels */
  @media (max-width: 900px) {
    .stage { --w: min(14rem, 27vw); }
    .lv2 { display: none; }
  }
  /* phone: sirf Agni-5 aur BrahMos, badi */
  @media (max-width: 560px) {
    .stage { --w: calc((100vw - 2.75rem) / 2); gap: 0.75rem; padding-inline: 1rem; }
    .lv1 { display: none; }
    .reel-title { font-size: 0.9rem; }
  }
</style>
