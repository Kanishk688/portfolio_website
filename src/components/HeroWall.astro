---
// HERO WALL — sirf reels ki chalti hui deewar (web aur phone dono pe).
// Desktop: 4 patti upar-neeche. Phone: 2 patti daayein-baayein
// (patti 1 aur 4 — dono milke saari 12 reels dikhati hain).
// Kisi bhi reel pe click = video player (awaaz ke saath).
// Mouse upar le jaao to deewar ruk jaati hai.
// Poster: public/wall/<id>.webp (480px). Video: public/video/<id>-loop.mp4.
// Sirf wahi video chalti hai jo screen pe dikh rahi ho (phone ki battery bachane ke liye).

const lanes: string[][] = [
  ['agni5', 'doodh', 'laser', 'yamuna', 'ev', 'aankh'],          // phone pe dikhti hai
  ['saans', 'ev', 'machhar', 'doodh', 'brahmos', 'laser'],
  ['yamuna', 'helmet', 'agni5', 'cable', 'aankh', 'gangajal'],
  ['gangajal', 'brahmos', 'saans', 'cable', 'helmet', 'machhar'], // phone pe dikhti hai
];
---

<div class="wall" aria-hidden="true">
  {lanes.map((lane, li) => (
    <div class={`lane l${li}`}>
      <div class="track">
        {[0, 1].map(() => lane.map((id) => (
          <button type="button" class="tile" data-vid={id} tabindex="-1">
            <video muted loop playsinline preload="none" poster={`/wall/${id}.webp`} data-loop={`/video/${id}-loop.mp4`} width="9" height="16"></video>
          </button>
        )))}
      </div>
    </div>
  ))}
</div>

<script>
  function setupWall() {
    const wall = document.querySelector<HTMLElement>('.wall');
    if (!wall || wall.dataset.ready) return;
    wall.dataset.ready = '1';

    wall.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-vid]');
      if (!b) return;
      (document.querySelector(`.vcard[data-vid="${b.dataset.vid}"]`) as HTMLElement | null)?.click();
    });

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // Jo reel screen pe aaye wo chale, jo bahar jaaye wo ruk jaaye.
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        const v = en.target as HTMLVideoElement;
        if (en.isIntersecting) {
          if (!v.src) v.src = v.dataset.loop!;
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      }
    }, { rootMargin: '80px' });
    wall.querySelectorAll('video').forEach((v) => io.observe(v));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  document.addEventListener('astro:page-load', setupWall);
</script>

<style>
  .wall {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    height: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 12%, #000 88%, transparent 100%);
            mask-image: linear-gradient(to bottom, transparent 0, #000 12%, #000 88%, transparent 100%);
  }
  .lane { position: relative; min-width: 0; }
  .track {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    animation: drift-y 80s linear infinite;
  }
  .l1 .track { animation-duration: 95s; animation-direction: reverse; }
  .l2 .track { animation-duration: 72s; }
  .l3 .track { animation-duration: 104s; animation-direction: reverse; }
  .wall:hover .track { animation-play-state: paused; }

  /* gap ko bhi shamil karna hai, warna loop pe jhatka lagta hai */
  @keyframes drift-y { to { transform: translateY(calc(-50% - 0.45rem)); } }
  @keyframes drift-x { to { transform: translateX(calc(-50% - 0.35rem)); } }

  .tile {
    display: block;
    flex: none;
    padding: 0;
    border: 0;
    background: var(--raised);
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 0 0 1px rgba(255,255,255,.07), 0 14px 30px rgba(0,0,0,.35);
    transition: transform .3s ease, box-shadow .3s ease;
  }
  .tile:hover { transform: scale(1.03); box-shadow: 0 0 0 2px var(--sun), 0 18px 40px rgba(0,0,0,.5); }
  .tile video { display: block; width: 100%; height: auto; aspect-ratio: 9 / 16; object-fit: cover; }

  /* ---- phone / tablet: 2 patti, daayein-baayein chalti ---- */
  @media (max-width: 900px) {
    .wall {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      height: auto;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
              mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
    }
    .l1, .l2 { display: none; }
    .track {
      flex-direction: row;
      gap: 0.7rem;
      width: max-content;
      animation-name: drift-x;
      animation-duration: 55s;
    }
    .l3 .track { animation-duration: 66s; }
    .tile { height: 13rem; }
    .tile video { height: 100%; width: auto; }
  }
</style>
