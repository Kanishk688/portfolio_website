---
// HEADER — naam, 4 seedhe links, aur email ka button.
// Links home page ke sections pe le jaate hain, taaki recruiter
// ek click me kisi bhi tarah ka kaam dekh sake.
const links = [
  { href: '/#videos', label: 'Videos' },
  { href: '/#illustration', label: 'Illustration' },
  { href: '/#comics', label: 'Comics' },
  { href: '/#about', label: 'About' },
];
---

<header class="site-head">
  <nav class="wrap nav">
    <a href="/" class="brand">Kanishk Verma</a>
    <ul class="links">
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
    <a class="ig" href="https://www.instagram.com/unseen.3d/" target="_blank" rel="noopener" aria-label="Instagram: @unseen.3d">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg>
      <span>@unseen.3d</span>
    </a>
    <a class="btn head-btn" href="mailto:kanishkverma688@gmail.com" aria-label="Email me">
      <svg class="mail-ic" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      <span class="mail-tx">Email me</span>
    </a>
  </nav>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(23, 24, 58, 0.92);
    backdrop-filter: blur(10px);
    color: var(--night-ink);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4rem;
  }
  .brand { font-weight: 750; font-size: 1.15rem; letter-spacing: -0.02em; }
  .links {
    display: flex;
    gap: 1.6rem;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }
  .links a { color: var(--night-dim); font-weight: 500; }
  .links a:hover { color: var(--night-ink); }
  .head-btn { padding: 0.6rem 1.05rem; font-size: 0.95rem; }
  .ig {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.25);
    color: var(--night-ink);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1;
  }
  .ig:hover { border-color: var(--sun); color: var(--sun); }
  .mail-ic { display: none; }

  @media (max-width: 760px) {
    .site-head { position: static; }
    .nav { height: auto; flex-wrap: wrap; gap: 0.4rem 0.5rem; padding-block: 0.7rem; }
    .links { order: 3; width: 100%; margin: 0; gap: 1.2rem; overflow-x: auto; }
    .brand { font-size: 1rem; }
    .ig { margin-left: auto; padding: 0.45rem 0.6rem; font-size: 0.88rem; gap: 0.3rem; }
    .head-btn { padding: 0.5rem 0.6rem; }
    .mail-ic { display: block; }
    .mail-tx { display: none; }
  }
</style>
