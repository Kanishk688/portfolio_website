---
// HEADER = press docket ka top strip. Naam, registration dots, aur do links.
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Index' },
  { href: '/work/', label: 'Work' },
];
const isOn = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
---

<header style="border-bottom: 1px solid var(--ink); background: var(--paper);">
  <nav class="wrap" style="display:flex; align-items:center; justify-content:space-between; height:3.5rem; gap:1.5rem;">
    <a href="/" style="display:flex; align-items:center; gap:0.7rem;">
      <span class="regmark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="label" style="color: var(--ink); letter-spacing:0.14em;">Kanishk Verma</span>
    </a>

    <ul style="display:flex; align-items:center; gap:1.5rem; list-style:none; margin:0; padding:0;">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={['label', isOn(l.href) && 'label-mag']}
            style={isOn(l.href) ? '' : 'color: var(--ink-2);'}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
