---
// Ek kitaab / comic ka card: poori image, upar naam aur ek line —
// kitni images, kab. size = 'feature' (badi) / 'wide' (do khaane chaudi).
import type { CollectionEntry } from 'astro:content';
interface Props { p: CollectionEntry<'projects'>; size?: string }
const { p, size = '' } = Astro.props;

const n = p.data.gallery.filter((g) => typeof g === 'string' || !g.chapter?.startsWith('Rejected attempts')).length;
const unit = p.data.medium === 'comics' ? 'pages' : 'illustrations';
const year = p.data.date.getFullYear();
---

<a class:list={['proj-card', size]} href={`/work/${p.id}/`}>
  <div class="thumb"><img src={p.data.cover} alt="" loading="lazy" /></div>
  <div class="cap">
    <h3 class="h-card">{p.data.title.replace(/ — Textbook Illustrations$/, '')}</h3>
    <p class="meta">{n} {unit}, {year}</p>
  </div>
</a>
